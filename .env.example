# Copy this file to `.env` and adjust values. `.env` is git-ignored.

# Environment: development | test | production
NODE_ENV=development

# Port the HTTP server listens on
PORT=3000

# Set to "true" ONLY when running behind a reverse proxy / load balancer.
TRUST_PROXY=false

# Comma-separated browser origins allowed to call this API cross-origin.
# Leave empty to allow same-origin requests only.
CORS_ORIGIN=http://localhost:5173

# Rate limiting — defaults to 100 requests per 15 minutes per IP.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# --- Database -------------------------------------------------------------
# Required outside the test runner. Local example:
#   mongodb://127.0.0.1:27017/thought-management
# Atlas example:
#   mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/thought-management
MONGODB_URI=mongodb://127.0.0.1:27017/thought-management

# --- File storage ------------------------------------------------------
# "memory" (default) keeps uploads in-process — fine for local dev and tests.
# "s3" stores them in an S3 bucket; then S3_REGION and S3_BUCKET are required.
STORAGE_DRIVER=memory
# S3_REGION=us-east-1
# S3_BUCKET=thought-management-uploads
# S3_ENDPOINT=            # set for S3-compatible services (MinIO, R2)
# S3_FORCE_PATH_STYLE=false
# AWS credentials come from the standard AWS provider chain (AWS_ACCESS_KEY_ID,
# AWS_SECRET_ACCESS_KEY, shared config, or an instance/task role).

# Max upload size in bytes (default 25 MiB).
UPLOAD_MAX_BYTES=26214400
