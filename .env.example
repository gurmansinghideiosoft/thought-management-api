# Copy this file to `.env` and adjust values. `.env` is git-ignored.

# Environment: development | test | production
NODE_ENV=development

# Port the HTTP server listens on
PORT=3000

# Set to "true" ONLY when running behind a reverse proxy / load balancer.
TRUST_PROXY=false

# Comma-separated browser origins allowed to call this API cross-origin.
# Leave empty to allow same-origin requests only.
CORS_ORIGIN=http://localhost:5173

# Rate limiting — defaults to 100 requests per 15 minutes per IP.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
